# EPHEC Content Studio — variables d'environnement
# Sans les trois variables Supabase, l'application démarre en mode local (PGlite + ./data), réservé au développement.

# --- Supabase (production) -------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique « publishable » (ou anon). Elle n'est pas secrète : la sécurité repose sur les politiques RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings → Database → Connection string → « Transaction pooler » (port 6543). SECRET.
DATABASE_URL=postgres://postgres.xxxxxxxxxxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Facultatif -------------------------------------------------------------------
# Taille maximale d'un fichier (Mo). Vérifiez aussi la limite globale de Supabase Storage.
STUDIO_MAX_UPLOAD_MB=200
DATABASE_POOL_SIZE=5

# --- Mode local uniquement --------------------------------------------------------
# STUDIO_LOCAL_EMAIL=studio@ephec.local
# STUDIO_LOCAL_PASSWORD=Studio-EPHEC-2026!
# STUDIO_DATA_DIR=./data
