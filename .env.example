# --- Obligatoire en production -------------------------------------------------
# Adresse publique du site (utilisée dans les liens envoyés par email). Ne plus la changer après envoi.
PUBLIC_BASE_URL=https://agenda.ephec.be
# Clé maîtresse : chiffrement des jetons OAuth, signature des cookies, pseudonymisation. `openssl rand -base64 32`
APP_SECRET=
# Base PostgreSQL (Supabase, Azure Database for PostgreSQL, etc.). Sans valeur : PGlite local dans ./data.
DATABASE_URL=postgres://user:password@host:5432/ephec_calendar
# Premier administrateur, créé au premier démarrage si aucun utilisateur n'existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# --- Facultatif ------------------------------------------------------------------
# Ne pas créer les 3 événements de démonstration
SEED_DEMO=false
DATABASE_POOL_SIZE=10

# Ajout direct Google Agenda (Mode B) — console Google Cloud, client OAuth « Application Web »
# URI de redirection autorisée : <PUBLIC_BASE_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ajout direct Outlook / Microsoft 365 (Mode B) — Microsoft Entra, inscription d'application
# Types de comptes : « tout annuaire + comptes Microsoft personnels » ; redirection : <PUBLIC_BASE_URL>/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
